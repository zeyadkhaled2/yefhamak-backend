# Copy to .env and replace placeholders. Never commit your real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Optional direct connection for migrations (instead of Neon's pooler).
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
# Required only for live agent chat, provider checks, and LLM evaluations.
OPENROUTER_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Local demo API access (separate from your OpenRouter key).
DEMO_API_KEY=replace-with-a-random-local-key
# Keep false until you intentionally want real model calls.
LIVE_CHAT_ENABLED=false
# Optional JSON list; defaults include local frontend origins and the public Vercel site.
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://yefhamak.vercel.app"]
