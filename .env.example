# Copy this file to .env and fill in the values. NEVER commit .env to GitHub.

# Neon: paste the connection string exactly as Neon shows it.
# Use the POOLED one (host contains "-pooler") for the running app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DBNAME?sslmode=require

# Neon: the DIRECT one (no "-pooler"), used later for migrations.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Used from step 3 onward (the agent loop)
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-2.5-flash
